# =====================================================================
#  azizi-telegram-bot — نمونه فایل محیطی
#  این فایل را به .env کپی کنید:  cp .env.example .env
#
#  ⚠️ قانون طلایی: داخل .env فقط و فقط خطوط KEY=value بنویسید.
#     هیچ دستور شل، هیچ خروجی ترمینال، هیچ متن اضافه.
#     (یک دستور paste شده داخل .env = parse error = ربات مرده)
#  ⚠️ توکن را هیچ‌جا paste نکنید. اگر لو رفت: @BotFather → /revoke
# =====================================================================

# --- الزامی ---
BOT_TOKEN=123456:PUT-YOUR-TOKEN-HERE
ADMIN_IDS=111111111,222222222

# --- اختیاری: ریشه‌ی API تلگرام (برای هاست‌هایی که خروجی مستقیم ندارند) ---
# اگر هاست شما به api.telegram.org دسترسی ندارد (اکثر هاست‌های داخل ایران)،
# آدرس رله/میرور خودتان را اینجا بگذارید. مثال: https://tg.example.com
TELEGRAM_API_ROOT=https://api.telegram.org

# --- لاگ ---
LOG_LEVEL=INFO

# --- مسیر داده‌ها (نسبت به ریشه‌ی پروژه) ---
DATA_DIR=data

# --- وب‌هوک (فقط اگر حالت webhook را اجرا می‌کنید) ---
# secret_token در setWebhook و بررسی هدر X-Telegram-Bot-Api-Secret-Token
WEBHOOK_SECRET=
WEBHOOK_URL=
WEBHOOK_PATH=/telegram/webhook

# --- کاتالوگ محصولات (دوره / کتاب / جزوه) ---
SITE_BASE_URL=https://www.mahdiazizi.com
# کلید anon عمومی سایت (همان کلیدی که داخل جاوااسکریپت سایت هست)
SUPABASE_URL=https://qbsfotperzzhuimnpmto.supabase.co
SUPABASE_ANON_KEY=
# نام جدول‌ها — اگر در پروژه‌ی شما فرق دارد اینجا عوضش کنید
SUPABASE_TABLE_COURSES=courses
SUPABASE_TABLE_BOOKS=books
SUPABASE_TABLE_NOTES=notes
# اگر همه‌ی محصولات در یک جدول با ستون نوع هستند، این دو را پر کنید
SUPABASE_SINGLE_TABLE=
SUPABASE_TYPE_COLUMN=type
# مدت اعتبار کش کاتالوگ (ثانیه)
CATALOG_TTL=600
CATALOG_PAGE_SIZE=6

# --- پیام ناشناس ---
# 1 = اعلان فوری به ادمین‌ها، 0 = فقط داخل پنل ادمین دیده شود
ANON_NOTIFY=1
# اگر می‌خواهید پیام‌ها به یک گروه خصوصی هم برود (مثلا -1001234567890)
ANON_INBOX_CHAT_ID=

# --- رنگ دکمه‌ها: auto | native | off ---
# auto  = اگر نسخه‌ی python-telegram-bot پشتیبانی کند، استایل اعمال می‌شود
# native= اجبار به ارسال استایل (اگر کتابخانه پشتیبانی نکند خطا لاگ می‌شود)
# off   = هیچ استایلی ارسال نشود (دکمه‌های کلاسیک)
BUTTON_STYLE_MODE=auto

# --- تایم‌اوت بوت اپلیکیشن در حالت وب‌هوک (ثانیه) ---
BOOT_TIMEOUT=60
